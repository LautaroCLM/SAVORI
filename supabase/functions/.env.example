# Variables de la función firmar-imagen (subida de fotos de productos).
# Local: copiá este archivo a supabase/functions/.env (está en .gitignore) y completá las claves S3
# que muestra `npx supabase status` (S3_PROTOCOL_ACCESS_KEY_ID / S3_PROTOCOL_ACCESS_KEY_SECRET).
# Producción (Cloudflare R2): cargalas como secretos con `npx supabase secrets set ...`.

# Local:      http://127.0.0.1:54321/storage/v1/s3
# R2:         https://<ID_DE_CUENTA>.r2.cloudflarestorage.com
IMAGENES_S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
# Local: local · R2: auto
IMAGENES_S3_REGION=local
IMAGENES_S3_ACCESS_KEY_ID=
IMAGENES_S3_SECRET_ACCESS_KEY=
IMAGENES_BUCKET=imagenes
# URL pública de lectura del bucket (sin barra final).
# Local: http://127.0.0.1:54321/storage/v1/object/public/imagenes
# R2:    https://pub-<id>.r2.dev  o tu dominio propio, p. ej. https://img.tudominio.com
IMAGENES_URL_PUBLICA=http://127.0.0.1:54321/storage/v1/object/public/imagenes
