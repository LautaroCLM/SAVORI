{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Savori",
  "version": "0.1.0",
  "identifier": "app.savori.gestion",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Savori",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co https://*.r2.cloudflarestorage.com http://127.0.0.1:54321 ws://127.0.0.1:54321"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Business",
    "shortDescription": "Gestión integral de restaurantes",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"]
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
