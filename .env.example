# =============================================================================
# FRONTEND → copiar a .env.local
# Estas variables terminan en el bundle del navegador: SOLO claves públicas.
# =============================================================================
# Supabase → Project Settings → API (o la salida de `npx supabase start` en local)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=tu-anon-key

# App de escritorio (Tauri): ver .env.tauri (VITE_PUBLIC_URL = URL pública de la web, para los QR)

# =============================================================================
# SCRIPTS DE ADMINISTRACIÓN → copiar a .env.scripts (NUNCA al frontend ni a git)
# Usados por scripts/crear-restaurante.ts y scripts/crear-usuario.ts
# =============================================================================
# SUPABASE_URL=https://<tu-proyecto>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# =============================================================================
# CLOUDFLARE R2 (Fase 2) → secretos de la Edge Function, NO van en archivos .env del frontend
#   npx supabase secrets set R2_ACCOUNT_ID=... R2_ACCESS_KEY_ID=... R2_SECRET_ACCESS_KEY=... \
#       R2_BUCKET=... R2_PUBLIC_URL=https://img.tudominio.com
# =============================================================================
